gdl_version = "1.0"

# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for the Static CredStore Plugin.
#
# Fills credstore's extension point (`CredStorePluginClientV2`), declared by
# `implements`. This plugin's vendor and priority are read from source.

gear(
    deps = ["types-registry"],
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/credstore/plugins/static-credstore-plugin"),
    maturity = "preview",
    name = "Static CredStore Plugin",
    description = "Static credential storage backend plugin for development and single-tenant deployments.",
    category = "core-platform-integration",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-static-credstore-plugin",
        lib = "static_credstore_plugin",
        path = ".",
    ),

    # The point this plugin implements, by the GTS spec its host declares. The
    # declaration is the role; the `impl` in this crate is only checked against
    # it. No `sdk`: the host's SDK is the host's.
    implements = "cf.core.credstore.plugin.v2~",

    # The plugin's whole configuration: values are written through the
    # credstore API, never configured.
    config_schema = config(exposes = ["vendor", "priority"]),
)
