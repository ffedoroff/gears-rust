gdl_version = "1.0"

# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for the Vault CredStore Plugin.
#
# Fills credstore's extension point (`CredStorePluginClientV2`), declared by
# `implements`. This plugin's vendor and priority are read from source.

gear(
    deps = ["types-registry"],
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/credstore/plugins/vault-credstore-plugin"),
    maturity = "preview",
    name = "Vault CredStore Plugin",
    description = "HashiCorp Vault / OpenBao (KV v2) credential storage backend plugin.",
    category = "core-platform-integration",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-vault-credstore-plugin",
        lib = "vault_credstore_plugin",
        path = ".",
    ),

    # The point this plugin implements, by the GTS spec its host declares. The
    # declaration is the role; the `impl` in this crate is only checked against
    # it. No `sdk`: the host's SDK is the host's.
    implements = "cf.core.credstore.plugin.v2~",

    # The token sources (`token`, `token_file`, `token_env`) are not offered as
    # controls: a form that saved one would be writing a credential into the
    # description. `retry` is a nested table no control renders.
    config_schema = config(exposes = ["vendor", "priority", "address", "mount", "path_prefix", "namespace", "timeout_secs"]),
)
